# Copy ke `.env` dan customize sesuai kebutuhan deployment.
# docker compose otomatis baca .env di root.

# ml-service
CONFIG_PATH=/app/config.yaml
LOG_FILE=/app/logs/predictions.jsonl

# UI
ML_SERVICE_URL=http://ml-service:8000
DECISIONS_LOG=/app/data/decisions.jsonl

# Threshold prediksi (override config.yaml threshold field)
# FRAUD_THRESHOLD=0.5
